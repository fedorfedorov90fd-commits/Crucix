{
  "version": "2.1.1",
  "date": "2026-08-14",
  "project": {
    "name": "CRUCIX",
    "description": "Open Source Intelligence Terminal — OSINT-платформа для сбора и анализа данных из открытых источников",
    "goal": "Мониторинг глобальной ситуации через открытые источники",
    "architecture": "Модульная, все модули независимы и работают локально"
  },
  "modules": {
    "rss": {
      "name": "📡 RSS Лента",
      "description": "Сбор новостей из RSS-источников с фильтрацией по регионам (11 регионов)",
      "features": ["Импорт/экспорт OPML", "Автопрокрутка", "Региональные фильтры"]
    },
    "ai_chat": {
      "name": "🧠 AI Чат",
      "description": "Интерактивный помощник на основе локального AI (Ollama)",
      "features": ["Поддержка DeepSeek 1.5B", "Контекст проекта", "Knowledge Base"]
    },
    "geo_map": {
      "name": "🌍 Геополитическая карта",
      "description": "Интерактивная карта с маркерами событий и статусами стран",
      "features": ["187 стран с цветовой подсветкой", "30 маркеров новостей", "Переключение языков"]
    },
    "global_index": {
      "name": "📊 Глобальный индекс напряжённости",
      "description": "Расчёт индекса напряжённости на основе 5 компонентов",
      "components": ["Новости (NewsAPI)", "Термальные (FIRMS)", "Авиация (OpenSky)", "Геополитика", "Экономика"]
    },
    "historical_analysis": {
      "name": "📈 Исторический анализ",
      "description": "Сравнение текущего индекса с историческими периодами",
      "features": ["Аномалии", "Прогноз", "Сравнение периодов"]
    },
    "correlation": {
      "name": "🔗 Кросс-корреляция",
      "description": "Выявление связей между компонентами индекса",
      "features": ["Матрица корреляций", "Поиск задержек", "Аномалии"]
    },
    "infrastructure": {
      "name": "🏭 Критическая инфраструктура",
      "description": "Мониторинг объектов критической инфраструктуры",
      "features": ["Каскадные эффекты", "Уязвимости", "Карта объектов"]
    },
    "firms": {
      "name": "🔥 Пожары и тепловые аномалии",
      "description": "Мониторинг пожаров из данных NASA FIRMS",
      "features": ["Кластеризация", "Интенсивность", "Горячие точки"]
    },
    "opensky": {
      "name": "✈️ Авиационный трекинг",
      "description": "Трекинг самолётов в реальном времени",
      "features": ["Военные борты", "Аномалии", "Горячие точки"]
    },
    "acled": {
      "name": "⚔️ Конфликты и протесты",
      "description": "Мониторинг конфликтов из данных ACLED",
      "features": ["Анализ эскалации", "Прогноз тренда", "Статистика по жертвам"]
    },
    "fred": {
      "name": "💰 Экономические индикаторы",
      "description": "Экономические данные из FRED",
      "features": ["13 индикаторов", "Индекс стресса", "Производные индикаторы"]
    },
    "ships": {
      "name": "🚢 Морской трекинг",
      "description": "Мониторинг судов в реальном времени",
      "features": ["Тёмные суда", "Портовая активность", "Аномалии"]
    },
    "space": {
      "name": "🛰️ Космический мониторинг",
      "description": "Мониторинг спутников и космических объектов",
      "features": ["Спутники", "Запуски", "МКС", "Starlink/OneWeb"]
    },
    "ofac": {
      "name": "🔒 Санкционный мониторинг",
      "description": "Санкционные списки OFAC, EU, UN",
      "features": ["Проверка объектов", "Маркировка", "Аномалии"]
    },
    "noaa": {
      "name": "🌦️ Погода и океан",
      "description": "Погодные данные и предупреждения",
      "features": ["Ураганы", "Торнадо", "Наводнения", "Пожары"]
    },
    "newsapi": {
      "name": "📰 NewsAPI",
      "description": "Новостной поток из 80 000+ источников",
      "features": ["Поиск по ключевым словам", "Топ-новости по странам"]
    },
    "basket": {
      "name": "📦 Корзина данных",
      "description": "Хранение и управление собранными новостями",
      "features": ["Добавление/удаление", "Статистика по источникам"]
    }
  },
  "how_to": {
    "Запуск": "node server.mjs",
    "Порт": "3117",
    "URL": "http://localhost:3117",
    "Обновление": "Автоматическое обновление данных каждые 15 минут",
    "Запуск AI чата": "Открыть http://localhost:3117/ai-chat",
    "Запуск RSS ленты": "Открыть http://localhost:3117/rss-feed",
    "Запуск глобального индекса": "Открыть http://localhost:3117/global-index"
  },
  "technical": {
    "node_version": "20.x",
    "port": "3117",
    "ollama_model": "deepseek-r1:1.5b",
    "update_interval": "15 минут",
    "sources": {
      "rss": "400+ лент в OPML",
      "newsapi": "80 000+ источников",
      "firms": "NASA FIRMS",
      "opensky": "OpenSky Network",
      "acled": "ACLED API",
      "fred": "FRED API",
      "ships": "AISStream API",
      "space": "CelesTrak + Space-Track",
      "ofac": "OFAC SDN List",
      "noaa": "NOAA API"
    }
  }
}
