      }
    },
    {
      "id": "46c94f4f649571f1",
      "text": "Теннис Рейтинг АТР  1 (1). Янник Синнер (Италия) — 11 500 очков.",
      "title": "Результат",
      "url": "https://www.kommersant.ru/doc/8972243",
      "timestamp": "2026-09-22T13:57:53.000Z",
