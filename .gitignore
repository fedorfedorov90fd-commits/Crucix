# ============================================================
# Crucix .gitignore — публикация публичной части
# data/, core/, server/, endpoint-finder/ — ОФИЦИАЛЬНЫЕ, публикуются
# ============================================================

# --- Приватные папки (НИКОГДА в Git) ---
PROJECT/
AI_MEMORY/
logs/
LOGS/
backups/
reports/
snapshots/
snapshots_full/
runs/
test/
DATA/
CODE/
Тексты/
Чат/
Корзина/
Резервные копии/
1opml/
RSS_lenta/
node_modules/
venv/
__pycache__/

# --- Персональные копии (правило #42) ---
*[А-Яа-яЁё]*
* (копия)*
* (другая копия)*
* (3-я копия)*
*_копия*
*=*
*/=*
1server.mjs
новый файл
новый_файл
как надо делать.txt

# --- Бэкапы (любые формы) ---
*.bak
*.bak.*
*.bak_*
*.bak-*
*.backup
*.backup.*
*.old
*.old.*
*.tmp
*.swp
*.swo
*~
.gitignore.backup_before_strengthen

# --- Архивы ---
*.tar.gz
*.zip
*.7z
*.rar

# --- Секреты ---
.env
.env.*
!.env.example

# --- Логи ---
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python ---
*.py[cod]
.pytest_cache/

# --- Прочее ---
.DS_Store
.cache/
dist/
build/

# --- Persist (приватные данные внутри data/) ---
data/persist/*.json
