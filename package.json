{
  "name": "crucix",
  "version": "14.0.0",
  "description": "Crucix — Open Source Intelligence Terminal + Predictive Core",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node scripts/check-pages.mjs",
    "test:unit": "node --test tests/predict/*.test.mjs",
    "test:property": "node --test tests/property/*.property.mjs",
    "test:fuzz": "node --test tests/fuzz/*.fuzz.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:mutation": "node tests/mutation/run_all.mjs",
    "test:mutation:meta": "node tests/mutation/meta_learner.mutate.mjs",
    "test:mutation:hypergraph": "node tests/mutation/hypergraph.mutate.mjs",
    "test:mutation:attention": "node tests/mutation/attention.mutate.mjs",
    "test:mutation:coevolution": "node tests/mutation/coevolution.mutate.mjs",
    "test:all": "node tests/test_all_modules.mjs && node tests/mutation/run_all.mjs",
    "test:all-modules": "node tests/test_all_modules.mjs",
    "test:predict": "node tests/test_all_modules.mjs",
    "test:predict:integration": "node tests/integration/full_pipeline.test.mjs",
    "test:predict:property": "node tests/property/reflexive.property.mjs",
    "test:predict:mutation": "node tests/mutation/run_all.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.0.0-rc.12",
    "chromadb": "^3.5.0",
    "docx": "^9.7.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "AGPL-3.0",
  "author": "Crucix Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/fedorfedorov90fd-commits/Crucix"
  }
}
